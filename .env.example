# Canonical public URL of the deployed site (no trailing slash).
# On Vercel preview deployments, if this is empty the template falls back to the
# deployment's own URL so canonical links never point at the wrong domain.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Optional: Resend API key for the contact form.
# If left empty, the contact form falls back to a mailto: link.
RESEND_API_KEY=""

# Sender address shown on outgoing emails (must be verified with your provider)
CONTACT_FROM_EMAIL="no-reply@your-domain.com"

# Destination inbox for contact submissions
CONTACT_TO_EMAIL="hello@your-domain.com"
